# .env.example
# ============================================================
# AI World Models for Predictive Cyber Defence
# Email Alert System — Environment Variable Template
# ============================================================
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
#
#   cp .env.example .env
#   (then edit .env with your credentials)
#
# Gmail users: use a Gmail App Password, NOT your normal password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google account.)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_RECIPIENT=defender@example.com
ALERTS_ENABLED=true
ALERT_COOLDOWN_SECONDS=300
